<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/s1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/s1color"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cap1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="90dp"
                android:text="@string/cap1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dc1"
                android:layout_width="171dp"
                android:layout_height="196dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                android:text="@string/dc1"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/s2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/s2color"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cap2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="90dp"
                android:text="@string/cap2"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dc2"
                android:layout_width="171dp"
                android:layout_height="196dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:text="@string/dc2"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/s3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/s2color"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cap3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="90dp"
                android:text="@string/cap3"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dc3"
                android:layout_width="171dp"
                android:layout_height="196dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:text="@string/dc3"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/s4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/s1color"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/cap4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="90dp"
                android:text="@string/cap4"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dc4"
                android:layout_width="171dp"
                android:layout_height="196dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:text="@string/dc4"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>